# Surprise Store — copy this file to `.env` and fill in real values.
# Never commit `.env` to version control.

# local | production
APP_ENV=local

# --- MySQL (required) ---
DB_HOST=localhost
DB_NAME=surprise_store
DB_USER=root
DB_PASS=

# --- Session cookies ---
# Lax = good default; Strict = stricter; None requires HTTPS + secure cookies
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_LIFETIME=2592000

# --- TOTP / 2FA (RFC 6238) ---
# Issuer label shown in authenticator apps (public branding, not a cryptographic secret)
TOTP_ISSUER=Surprise Store
# Adjacent 30-second windows accepted (1–10)
TOTP_VERIFY_WINDOW=2
# Server-side entropy for NEW TOTP secret generation (recommended in production).
# Generate e.g. php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Leave empty only for legacy/dev; when set, new enrollments mix this with random_bytes().
APP_SECRET=

# --- Telegram order notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# --- Payment / email (add when integrating gateways; keep empty in repo) ---
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
